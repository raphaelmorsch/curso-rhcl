[lab-user@bastion ~]$ cat <<'EOF' > validate-rbac.sh
#!/bin/bash

check() {
  local expected="$1"
  local description="$2"
  shift 2

  local result
  result=$(oc auth can-i "$@" 2>/dev/null)

  if [[ "$result" == "$expected" ]]; then
    printf "[PASS] %s\n" "$description"
  else
    printf "[FAIL] %s (expected=%s, actual=%s)\n" \
      "$description" "$expected" "$result"
  fi
}

echo "=== OPENBANK API MANAGEMENT RBAC ==="

check yes "Owner can browse API catalog" \
  list apiproducts.devportal.kuadrant.io \
  -A --as=user1

check yes "Consumer can browse API catalog" \
  list apiproducts.devportal.kuadrant.io \
  -A --as=user2

check yes "Owner can publish APIs" \
  create apiproducts.devportal.kuadrant.io \
  -n openbank-core --as=user1

check yes "Owner can approve API keys" \
  create apikeyapprovals.devportal.kuadrant.io \
  -n openbank-core --as=user1

check yes "Consumer can request API keys" \
