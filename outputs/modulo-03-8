raphaelmorsch@ramoreir-mac openbank-lab % echo "=== OPENBANK GATEWAY ==="

oc get gateway -n openbank-gateway

echo "=== GATEWAY EXPOSURE ==="

oc get route -n openbank-gateway

echo "=== CORE API ROUTES ==="

oc get httproute -n openbank-core

echo "=== PARTNER API ROUTES ==="

oc get httproute -n openbank-partners

echo "=== ATTACHED ROUTES ==="

oc get gateway openbank-gateway \
  -n openbank-gateway \
  -o json | jq '.status.listeners[] |
  {name,attachedRoutes}'

echo "=== EXTERNAL CONNECTIVITY ==="

for API in customers accounts exchange premium legacy unstable
do
  printf "%-15s" "$API"

  curl -sS -o /dev/null \
    --max-time 10 \
    -w 'HTTP %{http_code}\n' \
    "https://${GATEWAY_HOST}/${API}"
done
