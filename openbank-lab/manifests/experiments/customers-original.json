{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "customers",
    "namespace": "openbank-core",
    "labels": {
      "app": "customers-api",
      "app.kubernetes.io/part-of": "openbank"
    }
  },
  "spec": {
    "hostnames": [
      "api-openbank.apps.cluster-mbh58.dyn.redhatworkshops.io"
    ],
    "parentRefs": [
      {
        "group": "gateway.networking.k8s.io",
        "kind": "Gateway",
        "name": "openbank-gateway",
        "namespace": "openbank-gateway",
        "sectionName": "http"
      }
    ],
    "rules": [
      {
        "backendRefs": [
          {
            "group": "",
            "kind": "Service",
            "name": "customers-api",
            "port": 8080,
            "weight": 1
          }
        ],
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/customers"
            }
          }
        ]
      }
    ]
  }
}
